u, no 800 dažādām skaņām, kuras viņi spēj uztvert jau dzimšanas brīdī. Bet ir viens nosacījums: ar zīdaiņiem ir jārunā. To varētu nosaukt par balss nodarbībām jaundzimušajiem.","human_date":"Oktobris · Novembris · Decembris 2026","start_date":"26/09/2026","end_date":"25/12/2026","color_primary":"#5A2C32","color_primary_dark":"#541B23","splash":true,"credits":[{"name":"Principal Contributor","value":"Elenas Vaitas Mantojuma centrs"}],"lessons":[{"number":1,"title":"Runā Radītājs","start_date":"26/09/2026","end_date":"02/10/2026"},{"number":2,"title":"Pravieša aicināšana","start_date":"03/10/2026","end_date":"09/10/2026"},{"number":3,"title":"Vecās Derības pravieši","start_date":"10/10/2026","end_date":"16/10/2026"},{"number":4,"title":"Jaunās Derības pravieši","start_date":"17/10/2026","end_date":"23/10/2026"},{"number":5,"title":"Atklāsme un inspirācija","start_date":"24/10/2026","end_date":"30/10/2026"},{"number":6,"title":"Pravietiskie raksti","start_date":"31/10/2026","end_date":"06/11/2026"},{"number":7,"title":"Tagad klausieties!","start_date":"07/11/2026","end_date":"13/11/2026"},{"number":8,"title":"Pravietisko rakstu izpratne","start_date":"14/11/2026","end_date":"20/11/2026"},{"number":9,"title":"Praviešu pārbaudīšana","start_date":"21/11/2026","end_date":"27/11/2026"},{"number":10,"title":"Pravietiskā autoritāte un nozīmīgums","start_date":"28/11/2026","end_date":"04/12/2026"},{"number":11,"title":"Pravietiskā atklāsme izšķirošos brīžos","start_date":"05/12/2026","end_date":"11/12/2026"},{"number":12,"title":"Pēdējo Dienu pravietiskās atklāsmes","start_date":"12/12/2026","end_date":"18/12/2026"},{"number":13,"title":"Svētības no pravietiskā vārda","start_date":"19/12/2026","end_date":"25/12/2026"}]}]}