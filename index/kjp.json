{"code":"kjp","quarters":[{"id":"2026-02","title":"ဆၧဒိၪထၪ့ထီၫထၪ့လၧဆၧဘၪထွ့ၫဖံၭ၁ိၭလိၬ၁ၭ လၧကဆါယွၩ","description":"မွဲနဂဲၫဒိၪထၪ့လၧ ၦမုၬနွ့ၫနံၩဆၧအီၪကီၪ့ဖၧၩ့မွဲဂ့ၩ, ဒဲအ့ၪမွဲၦအ၁ၫ့လဂၩ လၧဆၧဆူဆၧနဲၩယီၩမွဲဂ့ၩ, ထီးမွဲနဖီဘၪမး၁ံၫနံၩဆၧမၩလိၪယီၩတၭ နမိ၁့ၪယၫ ဘၪဆၧအကၧၩ့ဒိၪထုၬလမံၩ့နီၪ မွဲ၀့ၫဒၪဆၧဒိၪထၪ့ (ဆၧအၪထၪ့ဂီထၪ့) လၧဆၧ ဘၪထွ့ၫဖံၭ၁ိၭလိၬလမံၩ့ကဆါယွၩအဆၧမၩအ၁ၭနီၪလီၫ.","human_date":"အ့ဖြ့ၫ · မ့ၫ · ယူၫ 2026","start_date":"28/03/2026","end_date":"26/06/2026","color_primary":"#0A454E","color_primary_dark":"#01373F","splash":true,"credits":[],"lessons":[{"number":1,"title":"ဆၧယိထံၫမၩခွါအဘၪအတီၩ","start_date":"28/03/2026","end_date":"03/04/2026"},{"number":2,"title":"မိ၁့ၪယၫကဆါယွၩအဂဲး","start_date":"04/04/2026","end_date":"10/04/2026"},{"number":3,"title":"ဆၧအီၪက့ၪထၪ့ထီၫ၁ၭဒဲၩဆၧဆၪ့လၩ့၁ၭ","start_date":"11/04/2026","end_date":"17/04/2026"},{"number":4,"title":"လံၬဆံၫ့ဎံၪအလးအလၩ","start_date":"18/04/2026","end_date":"24/04/2026"},{"number":5,"title":"မိအၪ့ဎၬနၪ၁့ၪလံၬဆံၫ့ဎံၪဘဲၫ၁့ၪလဲၪ","start_date":"25/04/2026","end_date":"01/05/2026"},{"number":6,"title":"ဆၧဘၩဆိၪဖၪအ၁ုၭဖိၫလဖၪ","start_date":"02/05/2026","end_date":"08/05/2026"},{"number":7,"title":"ဆၧဘၩဆိၪဖၪအလၩ့ထံး","start_date":"09/05/2026","end_date":"15/05/2026"},{"number":8,"title":"အီၪက့ၪဆၧဆူဆၧနဲၩ","start_date":"16/05/2026","end_date":"22/05/2026"},{"number":9,"title":"ဆၧဒဲၩဘၭ, ဆၧ၁ၭထိၬအပရၧၫ့, ဒဲဆၧ၁ီၪ့ဆၧ၁ၫ့","start_date":"23/05/2026","end_date":"29/05/2026"},{"number":10,"title":"ဆၧနီၪ့ယါဒဲဆၧကွဲၪဖျါ","start_date":"30/05/2026","end_date":"05/06/2026"},{"number":11,"title":"ဆၧမၩယံၬမၩနးဆၧလဖၪ","start_date":"06/06/2026","end_date":"12/06/2026"},{"number":12,"title":"အၪ့နၩ့လၩ့ကဆါလၧၦဂူၫဂၩ","start_date":"13/06/2026","end_date":"19/06/2026"},{"number":13,"title":"လၧဆၧအဆိၩအကၠၪအဖၧၩ့","start_date":"20/06/2026","end_date":"26/06/2026"}]},{"id":"2026-03","title":"၁ ကီရံၫ့ ဒဲ ၂ ကီရံၫ့","description":"ဆၧကွ့ၭလံၬပရၧၫ့နီၪ အီၪ၀့ၫယံၬလ့ၬယူၭလၧ ဖျိၩ့ဖျိၩ့အီၩလါနၫ့ဂ့ၩအထီလူၬ ယူၭ (?ခတ်နောက်ကျ) နီၪအီၪ၁့ၪအ့ၬ. အီၪဒၪလံၬလဲအခံးအဂၩ့အၪ့လဲၩအ၁ၭ လမံၩ့လီၫ. မွဲမၬ, ၡၩခံးဂးဆၧဆုးကျိၭအဖျီၩ့ (social media) နီၪ အၪ့လဲၩခွံၬ စၭခီၫအလးယူၭလီၫ. လါနၫ့ဂ့ၩ, ဆၧထံၫဆၧဒီၪအ၁ၭမွဲအီၪမီၪ့ဎီၩ့ (မီၪ့မီၪ့) ဒၪလီၫ-ဆုးကျိၭခမျၧး၁ံၪလၧ ဆၧဒုၭဘိၭဘၪ၁့ၪယၫလိၬ၁ၭလါခီၫလါခီၫ, ဖ့ၪနၩ့လၩ့ ဆၧပရၧၫ့၁ံၪ, ဆၧ၁ၭဘၪထိး (feelings) ၁ံၪ, ဒဲဆၧစီၪဆီၫ့မီၪ့ဆၧ၁ံၪလဖၪနီၪ လီၫ.","human_date":"ယူၫလဲၫ့ · အီၩဂၧၭ · စ့ၭပတဲၩ့ဘၧၫ့ 2026","start_date":"27/06/2026","end_date":"25/09/2026","color_primary":"#605045","color_primary_dark":"#4B3C32","splash":true,"credits":[],"lessons":[{"number":1,"title":"စပီလူၫအဆၧမၩလၧကီရံၫ့အဖၧၩ့","start_date":"27/06/2026","end_date":"03/07/2026"},{"number":2,"title":"ထုၪ့စူၪယၫအဆၧချဲၩ့","start_date":"04/07/2026","end_date":"10/07/2026"},{"number":3,"title":"ဆၧအီၪဎူၫအီၪဎၩ့လၧဎရံၬအဖၧၩ့","start_date":"11/07/2026","end_date":"17/07/2026"},{"number":4,"title":"ဆၧဒဲၩဘၭလၧဆၧအီ်ၪကီၪ့ဖၧၩ့","start_date":"18/07/2026","end_date":"24/07/2026"},{"number":5,"title":"ဆၧကိၭမံၩ့လၧယွၩအလၩအဖၩ့အဂး","start_date":"25/07/2026","end_date":"31/07/2026"},{"number":6,"title":"၁ၭမုအဆၧဖ့ၪလၫ့လဖၪ","start_date":"01/08/2026","end_date":"07/08/2026"},{"number":7,"title":"ဆၧအဲၪအဆၧထုၭဖျီၪနဲၪဂၩ့","start_date":"08/08/2026","end_date":"14/08/2026"},{"number":8,"title":"ဎရံၬအဆၧဂဲထုၪ့မၧၫ့ထၪ့ထဲၩ့အစီၩ့အမၩ့","start_date":"15/08/2026","end_date":"21/08/2026"},{"number":9,"title":"ယွၩအဆၧအဲၪအဆၧဖံၭဆၧမၩ","start_date":"22/08/2026","end_date":"28/08/2026"},{"number":10,"title":"ဎရံၬဖိၪအဆၧမၩအမွဲအတီၩ","start_date":"29/08/2026","end_date":"04/09/2026"},{"number":11,"title":"ဆၧယိထွ့ၫပၧၩ့ထၬဆၧဒဲ (့ငျျငသည) အဆၧမၩ","start_date":"05/09/2026","end_date":"11/09/2026"},{"number":12,"title":"ဆၧဆၧၫ့ယၫမၩဆၧလၧဆရၫအဘျံၭအဘျၪလဖၪ","start_date":"12/09/2026","end_date":"18/09/2026"},{"number":13,"title":"ဆၧအခိးအတၩ, ဆၧအဲၪဒဲဆၧဖံၭထံၩဖံၭ၁ိၭ","start_date":"19/09/2026","end_date":"25/09/2026"}]},{"id":"2026-01","title":"ဆၧမၩဘၪလၩ့ဎိၭမူၭခိၪဒဲဂၪ့ခိၪ ကဆါဎရံၬလၧလံၬဖလံဖံၫဒဲကလီစံၫအဖၧၩ့","description":"ဆီၫ့မီၪ့ထဲၩ့ဆၧမၩလၧနမၩဘၪအကၪထုၬနီၪဆံၭ. မွဲဆၧနီၪမၩကၪဆၧလဲၪ. မွဲဆၧယိလါလၧအမိဘၪ (အကဘၪ) ကဲၪထၪ့နီၪဧၪ, မွဲဆၧအဆၧၫ့အထီ လလၧၫ့ဎွ့ၩဘၪဧၪ, မွဲဆၧနံၫမံၩ့လူၬနီၪဧၪ. မွဲနဆၧအီၪက့ၪ၁ၭလၧနဆၧမၩ အဖၫ့ခိၪနီၪဧၪ. ဘၪလဘၪမွဲလၧၦမၩဎုၬဆၧလၧနၧၩနီၪ, မိမွဲ၀့ၫဒၪလၧဆၧမၩ အ၁ၭဖျီၪလၧကဲၪထၪ့လ၁့ၪဘၪနီၪဧၪ.","human_date":"ဇၫ့န၀ၫရံၫ · ဖ့ၭဖၫ၀ၫရံၫ · မၬခၠ် 2026","start_date":"27/12/2025","end_date":"27/03/2026","color_primary":"#2E4161","color_primary_dark":"#1E2C44","splash":true,"credits":[],"lessons":[{"number":1,"title":"ဘၪဆၧမၩနၧၩ့မၩစၪ၀့ၫလါနၫ့ဘၪဆၧခွံၬၡိၬထး၀့ၫအ့ၬ","start_date":"27/12/2025","end_date":"02/01/2026"},{"number":2,"title":"ဂဲးဖးလဖၪလၧဆၧစံၭထၪ့အၪ့အူၭဆၧအခိးအတၩ ဒဲဆၧလၧဆၧဘၩဆိၪဖၪဆၧအဂး","start_date":"03/01/2026","end_date":"09/01/2026"},{"number":3,"title":"ဆၧမၧၫ့ဒဲဆၧ၁ံၫ","start_date":"10/01/2026","end_date":"16/01/2026"},{"number":4,"title":"ဆၧ၁ၭဘၪလၩ့ဎိၭလၧဆၧဆၪ့လၩ့၁ုၪ့ဆၪ့လၩ့၁ၭအဖၧၩ့","start_date":"17/01/2026","end_date":"23/01/2026"},{"number":5,"title":"ဖၩ့ယဲဘဲၫဆၧဖၩ့လၧမုနၩအဆၧခံၭကျၩ","start_date":"24/01/2026","end_date":"30/01/2026"},{"number":6,"title":"၁ုၪ့ဂုး၁ၭခၧၫ့လၧဎရံၬအဖၧၩ့","start_date":"31/01/2026","end_date":"06/02/2026"},{"number":7,"title":"မူၭခိၪအဘၩ့မုးဖိၪလဂၩ","start_date":"07/02/2026","end_date":"13/02/2026"},{"number":8,"title":"ဎရံၬအဆၧ၁့ၪဂ့ၩ၁့ၪဘၪလၩ့ဆၫ့","start_date":"14/02/2026","end_date":"20/02/2026"},{"number":9,"title":"ဆၧမၩဘၪလိၬအိၭလိၬထဲၩ့ဆၧဒဲဆၧယိလါ","start_date":"21/02/2026","end_date":"27/02/2026"},{"number":10,"title":"လၧၫ့ထၪ့ဎွ့ၩထၪ့လၧကဆါဎရံၬအဖၧၩ့","start_date":"28/02/2026","end_date":"06/03/2026"},{"number":11,"title":"ဆၧအီၪမၧၫ့လၧဎရံၬအ၁ိၭ","start_date":"07/03/2026","end_date":"13/03/2026"},{"number":12,"title":"ဆၧအီၪမၧၫ့လၧၦဂူၫဂၩအ၁ိၭ","start_date":"14/03/2026","end_date":"20/03/2026"},{"number":13,"title":"အီၪဆၧၫ့ထုၪ့လၧယွၩအဆၧဘၪ၁ၭ","start_date":"21/03/2026","end_date":"27/03/2026"}]}]}