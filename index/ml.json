{"code":"ml","quarters":[{"id":"2026-01","title":"ആകാശത്തെയും ഭൂമിയെയും ഒന്നിപ്പിക്കുന്നു","description":"നിങ്ങൾ ഇതുവരെ ചെയ്‌തതിൽ വച്ച് ഏറ്റവും കഠിനമായ ജോലിയെക്കുറിച്ച് ചിന്തിക്കുക. എന്താണ് അതിനെ ബുദ്ധിമുട്ടാക്കിയത്? പ്രതീക്ഷകളോ, അതോ ജോലിക്ക് അനുവദിച്ച സമയമോ, അതോ രണ്ടും ആയിരുന്നോ? ജോലിയോടുള്ള നിങ്ങളുടെ മനോഭാവമോ? അല്ലെങ്കിൽ ഒരുപക്ഷേ നിങ്ങൾ പ്രവർത്തിച്ച ആളുകളാണോ? അല്ലെങ്കിൽ ഒരിക്കലും വിജയിക്കാൻ അസാധ്യമാണെന്ന് തോന്നിയിരിക്കാം?","human_date":"ജനുവരി · ഫെബ്രുവരി · മാർച്ച് 2026","start_date":"27/12/2025","end_date":"27/03/2026","color_primary":"#2E4161","color_primary_dark":"#1E2C44","splash":true,"credits":[],"lessons":[{"number":1,"title":"പീഡിപ്പിക്കപ്പെട്ടു പക്ഷേ ഉപേക്ഷിക്കപ്പെട്ടില്ല","start_date":"27/12/2025","end_date":"02/01/2026"},{"number":2,"title":"നന്ദിപ്രകടനവും പ്രാർത്ഥനയും അർപ്പിക്കുന്നതിനുള്ള കാരണങ്ങൾ","start_date":"03/01/2026","end_date":"09/01/2026"},{"number":3,"title":"ജീവിതവും മരണവും","start_date":"10/01/2026","end_date":"16/01/2026"},{"number":4,"title":"വിനയത്തിലൂടെയുള്ള ഐക്യം","start_date":"17/01/2026","end_date":"23/01/2026"},{"number":5,"title":"രാത്രിയിൽ വെളിച്ചങ്ങൾ പോലെ പ്രകാശിക്കുന്നു","start_date":"24/01/2026","end_date":"30/01/2026"},{"number":6,"title":"ക്രിസ്തുവിൽ മാത്രം ആത്മവിശ്വാസം","start_date":"31/01/2026","end_date":"06/02/2026"},{"number":7,"title":"ഒരു സ്വർഗ്ഗീയ പൗരത്വം","start_date":"07/02/2026","end_date":"13/02/2026"},{"number":8,"title":"ക്രിസ്തുവിന്റെ ശ്രേഷ്‌ഠത","start_date":"14/02/2026","end_date":"20/02/2026"},{"number":9,"title":"അനുരഞ്ജനവും പ്രത്യാശയും","start_date":"21/02/2026","end_date":"27/02/2026"},{"number":10,"title":"ക്രിസ്തുവിൽ പൂർണ്ണരാകുക","start_date":"28/02/2026","end_date":"06/03/2026"},{"number":11,"title":"ക്രിസ്തുവിനോടൊപ്പം ജീവിക്കൽ","start_date":"07/03/2026","end_date":"13/03/2026"},{"number":12,"title":"പരസ്പ്‌പരം ജീവിക്കുന്നു","start_date":"14/03/2026","end_date":"20/03/2026"},{"number":13,"title":"ദൈവഹിതത്തിൽ മുഴുവനായും നിലകൊള്ളുന്നു","start_date":"21/03/2026","end_date":"27/03/2026"}]},{"id":"2026-04","title":"പ്രവചനവരം","description":"നാഡീവ്യവസ്ഥയെക്കുറിച്ചും തലച്ചോറിന്റെ പ്രവർത്തനത്തെക്കുറിച്ചും ഗവേഷണം നടത്തുന്ന ശാസ്ത്രജ്ഞർ, മനുഷ്യശിശുക്കളുടെ ഭാഷാ സമ്പാദനത്തിനുള്ള അദ്ഭുതകരമായ സൗകര്യം മനസ്സിലാക്കാൻ തുടങ്ങി. 6 മാസം പ്രായമായ, ഒരു കുഞ്ഞിന് ഇംഗ്ലീഷ് വാക്കുകൾ ഉൾക്കൊള്ളുന്ന ശബ്ദങ്ങളോ മറ്റ് 7,000 ത്തിലധികം സംസാരിക്കുന്ന ഭാഷകളിൽ നിന്നുള്ള വാക്കുകളോ മനസ്സിലാക്കാൻ കഴിയും. രണ്ടാമത്തെ ഭാഷയുമായി സമ്പർക്കം പുലർത്തുകയാണെങ്കിൽ അവർക്ക് ആ ഭാഷയും സ്വന്തമാക്കാം. ഈ കാലയളവിൽ ഒരു നിഗൂഢമായ മാനസിക വാതിൽ തുറക്കുന്നു. ഇതു ശിശുക്കൾക്ക് ജനനസമയത്തു തിരിച്ചറിയാൻ കഴിയുന്ന 800 വ്യത്യസ്ത ശബ്ദങ്ങളിൽ നിന്ന് സാധാരണയായി ഒരു പ്രാദേശിക ഭാഷ ഉണ്ടാക്കുന്ന 40 അല്ലെങ്കിൽ അതിൽ കൂടുതൽ ശബ്ദങ്ങൾ വേർതിരിച്ചറിയാൻ അവർക്കു കഴിയും. എന്നാൽ ഒരു കാര്യമുണ്ട്. കുട്ടികളോട് സംസാരിക്കണം. നവജാത ശിശുക്കൾക്കുള്ള ശബ്ബത്ത് പാഠങ്ങൾ എന്ന് നിങ്ങൾക്ക് ഇതിനെ വിളിക്കാം.","human_date":"ഒക്ടോബർ · നവംബർ · ഡിസംബർ 2026","start_date":"26/09/2026","end_date":"25/12/2026","color_primary":"#54292F","color_primary_dark":"#3E1E22","splash":true,"credits":[],"lessons":[{"number":1,"title":"സ്രഷ്ടാവ് സംസാരിക്കുന്നു","start_date":"26/09/2026","end_date":"02/10/2026"},{"number":2,"title":"ഒരു പ്രവാചകന്റെ വിളി","start_date":"03/10/2026","end_date":"09/10/2026"},{"number":3,"title":"പഴയനിയമ പ്രവാചകന്മാർ","start_date":"10/10/2026","end_date":"16/10/2026"},{"number":4,"title":"പുതിയനിയമത്തിലെ പ്രവാചകന്മാർ","start_date":"17/10/2026","end_date":"23/10/2026"},{"number":5,"title":"വെളിപ്പാടും പരിശുദ്ധാത്മ പ്രചോദനവും","start_date":"24/10/2026","end_date":"30/10/2026"},{"number":6,"title":"പ്രവാചക എഴുത്തുകൾ","start_date":"31/10/2026","end_date":"06/11/2026"},{"number":7,"title":"ഇപ്പോൾ ഇതു കേൾക്ക","start_date":"07/11/2026","end_date":"13/11/2026"},{"number":8,"title":"പ്രവചന എഴുത്തുകൾ വ്യാഖ്യാനിക്കുന്നു","start_date":"14/11/2026","end_date":"20/11/2026"},{"number":9,"title":"പ്രവാചകന്മാരെ പരീക്ഷിക്കുക","start_date":"21/11/2026","end_date":"27/11/2026"},{"number":10,"title":"പ്രവചന അധികാരവും പ്രസക്തിയും","start_date":"28/11/2026","end_date":"04/12/2026"},{"number":11,"title":"നിർണ്ണായക നിമിഷങ്ങളിലെ പ്രാവചനിക ആവിഷ്കരണം","start_date":"05/12/2026","end_date":"11/12/2026"},{"number":12,"title":"അന്ത്യകാലത്തെ പ്രവചന വെളിപ്പെടുത്തലുകൾ","start_date":"12/12/2026","end_date":"18/12/2026"},{"number":13,"title":"പ്രവാചക വചനത്തിൽ നിന്നുള്ള അനുഗ്രഹങ്ങൾ","start_date":"19/12/2026","end_date":"25/12/2026"}]},{"id":"2026-02","title":"ദൈവവുമായുള്ള ബന്ധത്തിൽ വളരുക","description":"നിങ്ങൾ ഒരു സെവന്ത്-ഡേ അഡ്വൻ്റിസ്റ്റായി വളർന്നതാണോ? അതോ വിശ്വാസത്തിൽ പുതിയ ആളാണോ; നിങ്ങൾ മുതിർന്നവർക്കുള്ള വേദപുസ്‌തക പഠന സഹായിയായ പുസ്ത‌ കങ്ങൾ ഏറെയോ കുറച്ചോ വായിച്ചിട്ടുണ്ടോ? അവസാനമായി, ഇന്നു നിങ്ങൾ ആത്മീയമായി എവിടെയായിരുന്നാലും ദൈവവുമായി അർത്ഥവത്തായ ഒരു ബന്ധത്തിൽ എങ്ങനെ വളരാം എന്ന വിഷയം നിർണ്ണായകമാണ്.","human_date":"ഏപ്രിൽ · മേയ് · ജൂൺ 2026","start_date":"28/03/2026","end_date":"26/06/2026","color_primary":"#0A454E","color_primary_dark":"#01373F","splash":true,"credits":[],"lessons":[{"number":1,"title":"യാഥാർത്ഥ്യം പരിശോധിക്കുക","start_date":"28/03/2026","end_date":"03/04/2026"},{"number":2,"title":"ദൈവത്തെ അറിയുവാൻ","start_date":"04/04/2026","end_date":"10/04/2026"},{"number":3,"title":"അഹങ്കാരവും താഴ്‌മയും","start_date":"11/04/2026","end_date":"17/04/2026"},{"number":4,"title":"വേദപുസ്ത‌കത്തിന്റെ പങ്ക്","start_date":"18/04/2026","end_date":"24/04/2026"},{"number":5,"title":"വേദപുസ്‌തകം പഠിക്കുന്നത് എങ്ങനെ","start_date":"25/04/2026","end_date":"01/05/2026"},{"number":6,"title":"പ്രാർത്ഥനാ വീരന്മാർ","start_date":"02/05/2026","end_date":"08/05/2026"},{"number":7,"title":"പ്രായോഗിക പ്രാർത്ഥന","start_date":"09/05/2026","end_date":"15/05/2026"},{"number":8,"title":"വിശ്വാസം ഉണ്ടായിരിക്കുക","start_date":"16/05/2026","end_date":"22/05/2026"},{"number":9,"title":"പാപം, സുവിശേഷം, ന്യായപ്രമാണം","start_date":"23/05/2026","end_date":"29/05/2026"},{"number":10,"title":"മാനസാന്തരവും ക്ഷമയും","start_date":"30/05/2026","end_date":"05/06/2026"},{"number":11,"title":"തിരിച്ചടികൾ","start_date":"06/06/2026","end_date":"12/06/2026"},{"number":12,"title":"അവനെ പങ്കിടുക","start_date":"13/06/2026","end_date":"19/06/2026"},{"number":13,"title":"നിത്യതയിലേക്ക്","start_date":"20/06/2026","end_date":"26/06/2026"}]},{"id":"2026-03","title":"ക്രിസ്തീയ ജീവിതത്തിൻ്റെയും സാക്ഷ്യത്തിൻ്റെയും സാരാംശം","description":"കത്തുകൾ എഴുതൽ എന്നത് പഴയകാലം മുതൽ നിലവിലിരിക്കുന്ന കാലഹരണപ്പെട്ടിട്ടില്ലാത്ത ഒരു പ്രവർത്തനമാണ്. കത്തുകൾ എഴുതുന്ന രീതി മാത്രമാണ് നാം മാറ്റിയത്. അതേ, സമൂഹ മാധ്യമം കടലാസിനെ മറികടന്നു. എന്തായാലും അവയുടെ സാരാംശത്തിൽ, ഇ-മെയിലുകളും മറ്റ് ഇലക്ട്രോണിക് കത്തുകളും അടിസ്ഥാനപരമായി ഒരേ പ്രവർത്തനം നിർവ്വഹിക്കുന്നു: വിവരങ്ങൾ, വികാരങ്ങൾ, ചിന്തകൾ എന്നിവ കൈമാറ്റം ചെയ്തുകൊണ്ട് അവ ജനങ്ങളെ ബന്ധിപ്പിക്കുന്നു.","human_date":"ജൂലൈ · ആഗസ്റ്റ് · സെപ്റ്റംബർ 2026","start_date":"27/06/2026","end_date":"25/09/2026","color_primary":"#605045","color_primary_dark":"#4B3C32","splash":true,"credits":[],"lessons":[{"number":1,"title":"കൊരിന്ത്യയിൽ പൗലൊസിൻ്റെ ശുശ്രൂഷ","start_date":"27/06/2026","end_date":"03/07/2026"},{"number":2,"title":"ക്രൂശിന്റെ ദൂത്","start_date":"04/07/2026","end_date":"10/07/2026"},{"number":3,"title":"ക്രിസ്തുവിലുള്ള ഐക്യം","start_date":"11/07/2026","end_date":"17/07/2026"},{"number":4,"title":"സഭയിലെ പാപം","start_date":"18/07/2026","end_date":"24/07/2026"},{"number":5,"title":"എല്ലാം ദൈവത്തിന്റെ മഹത്വത്തിനായി","start_date":"25/07/2026","end_date":"31/07/2026"},{"number":6,"title":"ആത്മികവരങ്ങൾ","start_date":"01/08/2026","end_date":"07/08/2026"},{"number":7,"title":"ഒരു സ്നേഹചിത്രം","start_date":"08/08/2026","end_date":"14/08/2026"},{"number":8,"title":"ക്രിസ്തുവിന്റെ ഉയിർപ്പിന്റെ ശക്തി","start_date":"15/08/2026","end_date":"21/08/2026"},{"number":9,"title":"സ്നേഹം നിറഞ്ഞ ശുശ്രൂഷ","start_date":"22/08/2026","end_date":"28/08/2026"},{"number":10,"title":"യഥാർത്ഥ ക്രിസ്തീയ ശുശ്രൂഷ","start_date":"29/08/2026","end_date":"04/09/2026"},{"number":11,"title":"കാര്യവിചാരകത്വവും ദൗത്യവും","start_date":"05/09/2026","end_date":"11/09/2026"},{"number":12,"title":"ദുരുപദേഷ്ടാക്കന്മാരെ കൈകാര്യം ചെയ്യൽ","start_date":"12/09/2026","end_date":"18/09/2026"},{"number":13,"title":