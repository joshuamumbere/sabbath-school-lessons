 služby","start_date":"22/08/2026","end_date":"28/08/2026"},{"number":10,"title":"Autentická křesťanská služba","start_date":"29/08/2026","end_date":"04/09/2026"},{"number":11,"title":"Správcovství a poslání","start_date":"05/09/2026","end_date":"11/09/2026"},{"number":12,"title":"Jak čelit falešným učitelům","start_date":"12/09/2026","end_date":"18/09/2026"},{"number":13,"title":"Milost, láska a společenství","start_date":"19/09/2026","end_date":"25/09/2026"}]}]}