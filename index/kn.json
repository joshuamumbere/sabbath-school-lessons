{"code":"kn","quarters":[{"id":"2026-04","title":"ಪ್ರವಾದನೆಯ ವರ","description":"ನರ ವಿಜ್ಞಾನಿಗಳು ಹಸಿಗೂಸುಗಳ ಭಾಷೆಯನ್ನು ಗ್ರಹಿಸುವ ಅದ್ಭುತವಾದ ಮಾನವ ಸಾಮರ್ಥ್ಯವನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಪ್ರಯತ್ನ ಮಾಡುತ್ತಿದ್ದಾರೆ. ಆರು ತಿಂಗಳುಗಳಲ್ಲಿ, ಒಂದು ಮಗು ಸುಮಾರು ಮಾತೃಭಾಷೆಯ ಸುಮಾರು 7000 ಕ್ಕಿಂತ ಹೆಚ್ಚಾದ ಪದಗಳನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವ ಸಾಮರ್ಥ್ಯವನ್ನು ಹೊಂದಿರುತ್ತದೆ. ಅದೇ ರೀತಿಯಲ್ಲಿ ಎರಡನೆಯ ಭಾಷೆಯನ್ನು ಕೂಡ ಗ್ರಹಿಸುವ ಶಕ್ತಿಯನ್ನು ಹೊಂದಿರುತ್ತದೆ. ಈ ಹಂತದಲ್ಲಿ ನಿಗೂಢವಾದ ಮಾನಸಿಕ ಬಾಗಿಲು ತೆರೆಯುಲ್ಪಡುವುದು, ಈ ಹಂತದಲ್ಲಿ ಮಗುವು 40ಕ್ಕೂ ಅಥವಾ ಅದಕ್ಕಿಂತ ಹೆಚ್ಚು ಮಾದರಿಯ ಶಬ್ದಗಳನ್ನು ಹಾಗೂ 800 ವಿಭಿನ್ನವಾದ ಶಬ್ದಗಳನ್ನು ಒಳಗೊಂಡಿರುವ ಮಾತೃ ಭಾಷೆಯನ್ನು ಗ್ರಹಿಸುತ್ತದೆ. ಇದನ್ನು ನಾವು ಮಗುವಿನ ಶಬ್ದಗ್ರಹಿಕೆಯ ಸಾಮರ್ಥ್ಯವೆಂದು ಕರೆಯಬಹುದು.","human_date":"ಅಕ್ಟೋಬರ್ · ನವೆಂಬರ್ · ಡಿಸೆಂಬರ್ 2026","start_date":"26/09/2026","end_date":"25/12/2026","color_primary":"#54292F","color_primary_dark":"#3E1E22","splash":true,"credits":[{"name":"ಆಂಗ್ಲ ಮೂಲ","value":"ಎಲೆನ್ ಜಿ. ವೈಟ್"},{"name":"ಕನ್ನಡ ಭಾವಾನುವಾದ","value":"ಡಾಕ್ಟರ್ ಅಶೋಕ್ ಕುಮಾರ್ ಎನ್ ಮತ್ತು ಚಿನ್ನಪ್ಪ ಸಾತ್ವಿಕ್"}],"lessons":[{"number":1,"title":"ಸೃಷ್ಟಿಕರ್ತನು ಮಾತನಾಡುತ್ತಾನೆ","start_date":"26/09/2026","end_date":"02/10/2026"},{"number":2,"title":"ಪ್ರವಾದಿಯ ಕರೆಯುವಿಕೆ","start_date":"03/10/2026","end_date":"09/10/2026"},{"number":3,"title":"ಹಳೆಯ ಒಡಂಬಡಿಕೆಯ ಪ್ರವಾದಿಗಳು","start_date":"10/10/2026","end_date":"16/10/2026"},{"number":4,"title":"ಹೊಸ ಒಡಂಬಡಿಕೆಯ ಪ್ರವಾದಿಗಳು","start_date":"17/10/2026","end_date":"23/10/2026"},{"number":5,"title":"ಪ್ರಕಟನೆ ಮತ್ತು ದೈವಪ್ರೇರಣೆ","start_date":"24/10/2026","end_date":"30/10/2026"},{"number":6,"title":"ಪ್ರವಾದನಾತ್ಮಕ ಬರಹಗಳು","start_date":"31/10/2026","end_date":"06/11/2026"},{"number":7,"title":"ಈಗ ಇದನ್ನು ಕೇಳಿರಿ","start_date":"07/11/2026","end_date":"13/11/2026"},{"number":8,"title":"ಪ್ರವಾದನೆಯ ಬರಹಗಳನ್ನು ವ್ಯಾಖ್ಯಾನಿಸುವುದು","start_date":"14/11/2026","end_date":"20/11/2026"},{"number":9,"title":"ಪ್ರವಾದಿಗಳನ್ನು ಪರೀಕ್ಷಿಸುವುದು","start_date":"21/11/2026","end_date":"27/11/2026"},{"number":10,"title":"ಪ್ರವಾದನೆಯ ಅಧಿಕಾರ ಮತ್ತು ಪ್ರಸ್ತುತತೆ","start_date":"28/11/2026","end_date":"04/12/2026"},{"number":11,"title":"ನಿರ್ಣಾಯಕ ಸಮಯದಲ್ಲಿ ಪ್ರವಾದನೆಯ ಅಭಿವ್ಯಕ