сот различных звуков, которые ребенок способен воспринимать с рождения, он начинает выделять около сорока — те, что составляют звуковую основу его родного языка. Но есть одно условие: с младенцем нужно разговаривать. Можно назвать это уроками речи для новорожденных.","human_date":"Октябрь · Ноябрь · Декабрь 2026","start_date":"27/09/2026","end_date":"26/12/2026","color_primary":"#445144","color_primary_dark":"#2F382F","splash":true,"credits":[],"lessons":[{"number":1,"title":"Творец говорит","start_date":"27/09/2026","end_date":"03/10/2026"},{"number":2,"title":"Призвание пророка","start_date":"04/10/2026","end_date":"10/10/2026"},{"number":3,"title":"Пророки Ветхого Завета","start_date":"11/10/2026","end_date":"17/10/2026"},{"number":4,"title":"Пророки Нового Завета","start_date":"18/10/2026","end_date":"24/10/2026"},{"number":5,"title":"Откровение и богодухновенность","start_date":"25/10/2026","end_date":"31/10/2026"},{"number":6,"title":"Пророческие писания","start_date":"01/11/2026","end_date":"07/11/2026"},{"number":7,"title":"Слушай внимательно!","start_date":"08/11/2026","end_date":"14/11/2026"},{"number":8,"title":"Толкование пророческих писаний","start_date":"15/11/2026","end_date":"21/11/2026"},{"number":9,"title":"Испытание пророков","start_date":"22/11/2026","end_date":"28/11/2026"},{"number":10,"title":"Авторитет и актуальность пророческого слова","start_date":"29/11/2026","end_date":"05/12/2026"},{"number":11,"title":"Проявление дара пророчества в переломные моменты","start_date":"06/12/2026","end_date":"12/12/2026"},{"number":12,"title":"Пророческие откровения последнего времени","start_date":"13/12/2026","end_date":"19/12/2026"},{"number":13,"title":"Благословения пророческого слова","start_date":"20/12/2026","end_date":"26/12/2026"}]}]}