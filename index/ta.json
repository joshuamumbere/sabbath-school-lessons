{"code":"ta","quarters":[{"id":"2026-02","title":"தேவனுடன் உறவில் வளருதல்","description":"நீங்கள் பரம்பரை செவந்த்-டே அட்வெண்டிஸ்ட்டுகளாக இருக்கலாம்; அல்லது புதிய விசுவாசியாக இருக்கலாம்; நீங்கள் பெரியோர் ஓய்வுநாள் பள்ளி வேத ஆராய்ச்சி வழிகாட்டிகளில் எத்தனை வாசித்திருக்கிறீர்கள் என்கிற எண்ணிக்கை அதிகமாகவோ, குறைவாகவோ இருக்கலாம்; ஆவிக்குரிய நிலையில் எந்தக் கட்டத்தில் இருந்தாலும், தேவனோடு அர்த்தமுள்ள ஓர் உறவில் வளரவேண்டும் என்பதே முக்கியமானது.","human_date":"ஏப்ரல் · மே · ஜூன் 2026","start_date":"28/03/2026","end_date":"26/06/2026","color_primary":"#0A454E","color_primary_dark":"#01373F","splash":true,"credits":[{"name":"பாட ஆசிரியர்","value":"நீனா அட்செசன்"},{"name":"தமிழாக்கம்","value":"மார்சல் ஐசக், எஸ்றா டேவிட்"}],"lessons":[{"number":1,"title":"உண்மை நிலையை உணர்தல்","start_date":"28/03/2026","end_date":"03/04/2026"},{"number":2,"title":"தேவனை அறிந்துகொள்வதற்கு","start_date":"04/04/2026","end_date":"10/04/2026"},{"number":3,"title":"பெருமையும் தாழ்மையும்","start_date":"11/04/2026","end_date":"17/04/2026"},{"number":4,"title":"வேதாகமத்தின் பங்கு","start_date":"18/04/2026","end_date":"24/04/2026"},{"number":5,"title":"வேதாகமத்தை ஆராய்வது எப்படி?","start_date":"25/04/2026","end_date":"01/05/2026"},{"number":6,"title":"ஜெப வீரர்கள்","start_date":"02/05/2026","end_date":"08/05/2026"},{"number":7,"title":"நடைமுறை ஜெபம்","start_date":"09/05/2026","end_date":"15/05/2026"},{"number":8,"title":"விசுவாசம் உடையவராய் இருத்தல்","start_date":"16/05/2026","end_date":"22/05/2026"},{"number":9,"title":"பாவம், சுவிசேஷம், கட்டளைகள்","start_date":"23/05/2026","end_date":"29/05/2026"},{"number":10,"title":"மனமாற்றமும் பாவமன்னிப்பும்","start_date":"30/05/2026","end_date":"05/06/2026"},{"number":11,"title":"பின்னடைவுகள்","start_date":"06/06/2026","end_date":"12/06/2026"},{"number":12,"title":"அவரை அறிவியுங்கள்","start_date":"13/06/2026","end_date":"19/06/2026"},{"number":13,"title":"நித்தியத்திற்குள்","start_date":"20/06/2026","end_date":"26/06/2026"}]},{"id":"2026-04","title":"தீர்க்கதரிசன வரம்","description":"மொழியைக் கற்றுக்கொள்வதில் குழந்தைகளுக்குள்ள ஆச்சரியமான திறனைப்பற்றி நரம்பியல் விஞ்ஞானிகள் தற்போது புரிந்துகொள்ளத் தொடங்கியுள்ளனர். தமிழ் வார்த்தைகளை அல்லது உலகில் பேசப்படும் 7,000 க்கும் மேற்பட்ட பிற மொழிகளின் வார்த்தைகளை உருவாக்குகிற ஒலிகளை ஆறுமாதக் குழந்தையால் புரிந்துகொள்ள முடியும். அந்தச் சமயத்தில் இரண்டாவது மொழியை அவர்களுக்கு அறிமுகப்படுத்தினால், அதையும் எளிதாகக் கற்றுக் கொள்வார்கள். இந்தக் காலக்கட்டத்தில் திறக்கிற விசித்திரமான ஒரு மனத்திறன், குழந்தைகள் பிறக்கும்போது உணருகிற 800 வெவ்வேறு ஒலிகளிலிருந்து, ஒரு தாய் மொழியை உருவாக்குகிற சுமார் 40 ஒலிகளை மட்டும் பிரித்தறிய உதவுகிறது. ஆனால் இதில் ஒரு நிபந்தனை உள்ளது: குழந்தைகளுடன் யாராவது பேசவேண்டும். இதை பிறந்த குழந்தைகளுக்கான 'குரல் பயிற்சி' என்று அழைக்கலாம்.","human_date":"அக்டோபர் · நவம்பர் · டிசம்பர் 2026","start_date":"26/09/2026","end_date":"25/12/2026","color_primary":"#54292F","color_primary_dark":"#3E1E22","splash":true,"credits":[{"name":"பாட ஆசிரியர்","value":"ஒய்ட் எஸ்டேட் அலுவலகத்தின் ஊழியக்குழு"},{"name":"தமிழாக்கம்","value":"மார்சல் ஐசக், எஸ்றா டேவிட்"}],"lessons":[{"number":1,"title":"சிருஷ்டிகர் பேசுகிறார்","start_date":"26/09/2026","end_date":"02/10/2026"},{"number":2,"title":"ஒரு தீர்க்கதரிசியின் அழைப்பு","start_date":"03/10/2026","end_date":"09/10/2026"},{"number":3,"title":"பழைய ஏற்பாட்டுத் தீர்க்கதரிசிகள்","start_date":"10/10/2026","end_date":"16/10/2026"},{"number":4,"title":"புதிய ஏற்பாட்டுத் தீர்க்கதரிசிகள்","start_date":"17/10/2026","end_date":"23/10/2026"},{"number":5,"title":"வெளிப்படுத்தலும் தேவ ஏவுதலும்","start_date":"24/10/2026","end_date":"30/10/2026"},{"number":6,"title":"தீர்க்கதரிசன எழுத்துகள்","start_date":"31/10/2026","end_date":"06/11/2026"},{"number":7,"title":"இப்போதும் கேளுங்கள்!","start_date":"07/11/2026","end_date":"13/11/2026"},{"number":8,"title":"தீர்க்கதரிசனப் புத்தகங்களை விளக்குதல்","start_date":"14/11/2026","end_date":"20/11/2026"},{"number":9,"title":"தீர்க்கதரிசிகளைச் சோதித்தறிதல்","start_date":"21/11/2026","end_date":"27/11/2026"},{"number":10,"